# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/resume_db
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=resume_db

# ─── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM / AI ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key

# ─── App Configuration ──────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
APP_VERSION=2.1.0
DEBUG=false

# ─── Email / SMTP ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@ai-ats.local
EMAIL_ENABLED=false

# ─── OAuth Providers ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000/auth/callback

# ─── SAML SSO ─────────────────────────────────────────────────────────────
SAML_ENABLED=false
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_X509_CERT=
SAML_SP_ENTITY_ID=ai-ats
SAML_SP_ACS_URL=http://localhost:8000/api/auth/saml/acs
SAML_SP_SLS_URL=http://localhost:8000/api/auth/saml/sls

# ─── Password Policy ──────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ─── MFA ──────────────────────────────────────────────────────────────────
MFA_ENFORCE_FOR_ADMINS=true
MFA_ENFORCE_GLOBALLY=false
MFA_TOTP_ISSUER=AI-ATS
MFA_BACKUP_CODES_COUNT=8

# ─── Session Security ─────────────────────────────────────────────────────
SESSION_MAX_CONCURRENT=10
SESSION_INACTIVE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_DAYS=30

# ─── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=60

# ─── Monitoring ───────────────────────────────────────────────────────────
FLOWER_BASIC_AUTH=admin:password
METRICS_PORT=8000
