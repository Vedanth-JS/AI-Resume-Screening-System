# ==============================================================================
# AI Resume Screening & Applicant Tracking System — Environment Configuration
# ==============================================================================
# Copy this file to .env (root and backend/.env) and configure the variables below.

# ─── Database Configuration ───────────────────────────────────────────────────
# For local SQLite (Default & automatic fallback if Postgres is offline):
# DATABASE_URL=sqlite+aiosqlite:///./ai_ats.db
#
# For PostgreSQL / Supabase:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres

# ─── Application & Security ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true
APP_VERSION=2.1.0
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI / Large Language Models ──────────────────────────────────────────────
# Obtain a Google Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# (Optional) OpenAI API Key
OPENAI_API_KEY=

# ─── Redis & Celery (Optional for background worker queues) ───────────────────
# If Redis is not available, the system processes requests synchronously.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins or JSON array
CORS_ORIGINS=["http://localhost:8081", "http://127.0.0.1:8081", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]

# ─── Frontend Configuration (frontend/.env) ──────────────────────────────────
# Backend API base URL consumed by Vite React frontend
VITE_API_URL=http://localhost:8000/api

